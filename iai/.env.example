# Copie para iai/.env. Como está, roda 100% local e simulado (sem chaves, em localhost).

# Modos: auth/business = mock|spring | storage = mock|mongo | llm = demo|live
IAI_AUTH_MODE=mock
IAI_BUSINESS_MODE=mock
IAI_STORAGE_MODE=mock
IAI_LLM_MODE=demo

# API Spring (HTTPS fora de localhost; HTTP só para os hosts de INVENTRA_API_HTTP_HOSTS, ex.: 34.201.182.193)
INVENTRA_API_URL=http://localhost:8080
INVENTRA_API_HTTP_HOSTS=
INVENTRA_HTTP_TIMEOUT=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB (histórico, propostas e métricas)
MONGO_CONNECTION=mongodb://localhost:27017
IAI_MONGO_TIMEOUT_MS=10000

# Modelos (obrigatórios em IAI_LLM_MODE=live)
GEMINI_API_KEY=
GROQ_API_KEY=
IAI_PENSAMENTO=on

# JEV (TypeSafe): juiz das propostas. JEV_ESCOPO = escrita|todas
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_APPROVAL_THRESHOLD=0.70
JEV_TIMEOUT=10
JEV_ESCOPO=escrita

# Documentos como contexto (Qdrant); sem QDRANT_URL o recurso fica desligado
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=inventra_documentos
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
ARQUIVOS_MAX_BYTES=10485760
ARQUIVOS_MAX_POR_ENVIO=10
ARQUIVOS_MAX_POR_USUARIO=50
ARQUIVOS_MAX_CARACTERES=120000
ARQUIVOS_GUARDRAIL_LLM=on

# Métricas (premissas do /metrics)
METRICAS_REQ_USUARIO_SEMANA=10
METRICAS_VALOR_RESOLUCAO_USD=1.50

# Servidor MCP (token JWT do Spring; em modo mock use demo-supervisor)
IAI_MCP_TOKEN=

# LangSmith (opcional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=inventra-iai
