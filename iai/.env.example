# Demonstração local: identidade, dados e Mongo são SIMULADOS, sem credenciais.
# Copie para iai/.env. Execute apenas em localhost neste modo.
# iai/app/.env também é lido para variáveis ainda não definidas.
IAI_AUTH_MODE=mock
IAI_BUSINESS_MODE=mock
IAI_STORAGE_MODE=mock
IAI_LLM_MODE=demo
MONGO_CONNECTION=mongodb://localhost:27017
INVENTRA_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Tabela opcional por nome do modelo; input/output em USD por milhão de tokens.
# Sem tabela completa ou tokens reportados, custo fica nulo (não zero).
# IAI_MODEL_PRICES_JSON={}
# Modo real: auth=spring, business=spring, storage=mongo, llm=live.
# Configure as chaves abaixo fora do Git. O modo Spring não usa tokens demo.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Gate de tools dos agentes LIVE; sem autorização válida nenhuma tool executa.
# Demo determinístico e chamadas REST/MCP diretas mantêm seu comportamento.
# TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_APPROVAL_THRESHOLD=0.70
JEV_TIMEOUT=10
# escrita (padrão): JEV nas propostas; leituras mantêm as validações locais do gate.
# todas: JEV individual também nas leituras, incluindo FAQ e documentos.
JEV_ESCOPO=escrita

# Documentos como contexto (PDF, Word, Excel, PowerPoint, CSV, TXT, imagens) indexados no Qdrant.
# Sem QDRANT_URL/QDRANT_API_KEY o recurso fica desligado e o resto da IA funciona normalmente.
# QDRANT_URL=https://SEU-CLUSTER.REGIAO.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=inventra_documentos
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# ARQUIVOS_MAX_BYTES=10485760
# ARQUIVOS_MAX_POR_ENVIO=10
# ARQUIVOS_MAX_POR_USUARIO=50
# ARQUIVOS_MAX_CARACTERES=120000
# on (padrão): além das regras, um classificador LLM procura prompt injection nos arquivos (fail-closed).
# ARQUIVOS_GUARDRAIL_LLM=on
