# Demonstração local: identidade, dados e Mongo são SIMULADOS, sem credenciais.
# Copie para iai/.env. Execute apenas em localhost neste modo.
IAI_AUTH_MODE=mock
IAI_BUSINESS_MODE=mock
IAI_STORAGE_MODE=mock
IAI_LLM_MODE=demo
MONGO_CONNECTION=mongodb://localhost:27017
INVENTRA_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
# Tabela opcional por nome do modelo; input/output em USD por milhão de tokens.
# Sem tabela completa ou tokens reportados, custo fica nulo (não zero).
# IAI_MODEL_PRICES_JSON={}
# Modo real: auth=spring, business=spring, storage=mongo, llm=live.
# Configure as chaves abaixo fora do Git. O modo Spring não usa tokens demo.
# GEMINI_API_KEY=
# GROQ_API_KEY=
